# Copy to .env for local development. Never commit real values.
# On Cloud Run, set these as environment variables; keep GEMINI_API_KEY in Secret Manager.

# --- Server-only secret ---
# Gemini API key from https://aistudio.google.com/apikey. Without it, the offline rulebook is used.
GEMINI_API_KEY=
# Optional: Gemini model, thinking level (MINIMAL is fastest; DEFAULT keeps the model's own) and timeout.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=MINIMAL
GEMINI_TIMEOUT_MS=30000

# --- Public config (sent to the browser; not secret) ---
# OAuth 2.0 Web client id. Add http://localhost:5173, http://localhost:8080 and your Cloud Run URL
# as Authorized JavaScript origins. Without it, only Demo Mode is offered.
GOOGLE_CLIENT_ID=

# Firebase web app config (Raid Mode). Without it, Raid Mode is hidden.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# reCAPTCHA Enterprise site key for Firebase App Check.
RECAPTCHA_SITE_KEY=
# Reject API calls without a valid App Check token (production).
ENFORCE_APP_CHECK=false

# --- Local development ---
PORT=8080
# Allow the Vite dev server to call the API.
ALLOWED_ORIGINS=http://localhost:5173
# Point Firebase at the local emulators (tests).
USE_FIREBASE_EMULATORS=false
